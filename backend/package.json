{
  "name": "gymmatrix-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "build": "wrangler deploy --dry-run --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate:local": "wrangler d1 execute gymmatrix-db --local --file=src/db/schema.sql",
    "db:seed:local": "wrangler d1 execute gymmatrix-db --local --file=src/db/seed.sql",
    "db:migrate:remote": "wrangler d1 execute gymmatrix-db --remote --file=src/db/schema.sql",
    "db:seed:remote": "wrangler d1 execute gymmatrix-db --remote --file=src/db/seed.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20241022.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.80.0"
  }
}
